# 当前版本只支持不连接 DCE 的开发模式。
APP_ENV=development
DCE_MODE=mock
# 留空时使用上面的 SQLite 文件。配置后改用容器中的 PostgreSQL。
# DATABASE_URL=postgresql://quiz:quiz@127.0.0.1:5432/quiz

# 开发环境也建议替换；生产环境必须使用至少 32 字符的随机值。
SECRET_KEY=local-development-session-key-change-before-production
WEBHOOK_SECRET=local-webhook-secret
SESSION_TTL_SECONDS=28800

# 1：考试通过后由 Web 进程立即执行本地 Mock 授权；0：单独运行 worker.py。
DEV_AUTO_PROCESS_GRANTS=1
