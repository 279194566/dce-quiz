# 真实 DCE API + OIDC 联调模板。复制为 .env 后必须替换示例值并填写 Secret。
APP_ENV=development
DCE_MODE=real
DATABASE_PATH=./data/quiz-integration.db
# DATABASE_URL=postgresql://quiz:quiz@127.0.0.1:5432/quiz

SECRET_KEY=replace-with-a-random-string-at-least-32-characters
WEBHOOK_SECRET=replace-with-a-random-string-at-least-24-characters
SESSION_TTL_SECONDS=28800
DEV_AUTO_PROCESS_GRANTS=0

DCE_BASE_URL=https://dce.example.com
DCE_ACCESS_TOKEN=

# 已在目标 DCE 创建；客户端 Secret 只能通过运行环境注入，不得提交仓库。
OIDC_CLIENT_ID=dce-quiz
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
OIDC_SCOPES=openid profile email

# 当前联调入口使用本机不信任的证书。生产环境必须设为 0 并提供 DCE_CA_BUNDLE。
DCE_INSECURE_SKIP_TLS_VERIFY=1
DCE_CA_BUNDLE=

# 以下内容必须替换为目标平台中已经存在并完成授权的工作空间和用户组。
DCE_TARGET_WORKSPACE_ID=1001
DCE_TARGET_WORKSPACE_ALIAS=example-workspace
DCE_TARGET_WORKSPACE_ROLE=Workspace Viewer
DCE_TARGET_GROUP_ID=replace-with-dce-group-id
DCE_TARGET_GROUP_NAME=quiz-example-viewer
